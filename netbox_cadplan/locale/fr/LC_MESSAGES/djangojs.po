#: static/netbox_cadplan/js/plan_editor.js:138
msgid "Network error while confirming the layer."
msgstr "Erreur réseau lors de la confirmation du calque."

#: static/netbox_cadplan/js/plan_editor.js:162
#, python-format
msgid ""
"%(unchanged)s zone(s) unchanged, %(removed)s zone(s) removed "
"(%(objects)s placed object(s) will be removed), %(created)s new "
"zone(s)."
msgstr ""
"%(unchanged)s zone(s) inchangée(s), %(removed)s zone(s) supprimée(s) "
"(%(objects)s objet(s) posé(s) seront retirés), %(created)s nouvelle(s) "
"zone(s)."

#: static/netbox_cadplan/js/plan_editor.js:177
msgid "Apply"
msgstr "Appliquer"

#: static/netbox_cadplan/js/plan_editor.js:184
msgid "Cancel"
msgstr "Annuler"

#: static/netbox_cadplan/js/plan_editor.js:191
msgid "No layer found in this DXF file."
msgstr "Aucun calque trouvé dans ce fichier DXF."

#: static/netbox_cadplan/js/plan_editor.js:200
msgid "Choose a layer…"
msgstr "Choisissez un calque…"

#: static/netbox_cadplan/js/plan_editor.js:215
msgid "Confirm this layer"
msgstr "Confirmer ce calque"

#: static/netbox_cadplan/js/plan_editor.js:252
msgid "Reading layers from the DXF file…"
msgstr "Lecture des calques du fichier DXF…"

#: static/netbox_cadplan/js/plan_editor.js:261
msgid "Network error while reading layers."
msgstr "Erreur réseau lors de la lecture des calques."

#: static/netbox_cadplan/js/plan_editor.js:274
msgid "Loading preview…"
msgstr "Chargement de l'aperçu…"

#: static/netbox_cadplan/js/plan_editor.js:285
msgid "No elements found on this layer."
msgstr "Aucun élément trouvé sur ce calque."

#: static/netbox_cadplan/js/plan_editor.js:289
msgid "Konva.js could not be loaded."
msgstr "Konva.js n'a pas pu être chargé."

#: static/netbox_cadplan/js/plan_editor.js:322
msgid "Network error while previewing the layer."
msgstr "Erreur réseau lors de l'aperçu du calque."

#: static/netbox_cadplan/js/plan_editor.js:330
msgid "Top"
msgstr "En haut"

#: static/netbox_cadplan/js/plan_editor.js:330
msgid "Bottom"
msgstr "En bas"

#: static/netbox_cadplan/js/plan_editor.js:330
msgid "Left"
msgstr "À gauche"

#: static/netbox_cadplan/js/plan_editor.js:331
msgid "Right"
msgstr "À droite"

#: static/netbox_cadplan/js/plan_editor.js:331
msgid "Center"
msgstr "Au centre"

#: static/netbox_cadplan/js/plan_editor.js:1102
msgid "Place"
msgstr "Placer"

#: static/netbox_cadplan/js/plan_editor.js:1133
msgid "Shape not configured"
msgstr "Forme non configurée"

#: static/netbox_cadplan/js/plan_editor.js:1145
msgid "Racks"
msgstr "Racks"

#: static/netbox_cadplan/js/plan_editor.js:1145
msgid "Unracked devices"
msgstr "Devices non rackés"

#: static/netbox_cadplan/js/plan_editor.js:1167
msgid "No objects available."
msgstr "Aucun objet disponible."

#: static/netbox_cadplan/js/plan_editor.js:1199
msgid "Click an object placed on the plan to view its properties."
msgstr "Cliquez sur un objet placé sur le plan pour voir ses propriétés."

#: static/netbox_cadplan/js/plan_editor.js:1225
msgid "Rotation (°)"
msgstr "Rotation (°)"

#: static/netbox_cadplan/js/plan_editor.js:1245
msgid "Snap to wall"
msgstr "Aimanter au mur"

#: static/netbox_cadplan/js/plan_editor.js:1260
msgid "Outside the walls"
msgstr "Hors des murs"

#: static/netbox_cadplan/js/plan_editor.js:1280
msgid "Name position"
msgstr "Position du nom"

#: static/netbox_cadplan/js/plan_editor.js:1357
msgid "Remove from plan"
msgstr "Retirer du plan"

#: static/netbox_cadplan/js/plan_editor.js:1631
msgid "Activate the tool above the plan, then click the device to move."
msgstr "Activez l'outil au-dessus du plan, puis cliquez sur l'appareil à déplacer."

#: static/netbox_cadplan/js/plan_editor.js:1638 static/netbox_cadplan/js/plan_editor.js:1771
msgid "Click the device you want to move."
msgstr "Cliquez sur l'appareil que vous souhaitez déplacer."

#: static/netbox_cadplan/js/plan_editor.js:1648
msgid "Moving:"
msgstr "Déplacement :"

#: static/netbox_cadplan/js/plan_editor.js:1654
msgid "Hover a wall or a device edge, then click to select it."
msgstr "Survolez un mur ou le bord d'un appareil, puis cliquez pour le sélectionner."

#: static/netbox_cadplan/js/plan_editor.js:1664
msgid "Reference: a wall"
msgstr "Référence : un mur"

#: static/netbox_cadplan/js/plan_editor.js:1668
#, python-format
msgid "Reference: edge of %(name)s"
msgstr "Référence : bord de %(name)s"

#: static/netbox_cadplan/js/plan_editor.js:1677
msgid "Distance (mm)"
msgstr "Distance (mm)"

#: static/netbox_cadplan/js/plan_editor.js:1709
msgid "Enter a valid distance."
msgstr "Saisissez une distance valide."

#: static/netbox_cadplan/js/plan_editor.js:1713
msgid "Distance must be zero or greater."
msgstr "La distance doit être supérieure ou égale à zéro."

#: static/netbox_cadplan/js/plan_editor.js:1740
msgid "This position is not valid: the object would be outside the room or overlapping another zone."
msgstr "Cette position n'est pas valide : l'objet se retrouverait hors de la pièce ou chevaucherait une autre zone."

#: static/netbox_cadplan/js/plan_editor.js:1775
msgid "This object cannot be positioned with this tool: its rotation must be 0°, 90°, 180° or 270°."
msgstr "Cet objet ne peut pas être positionné avec cet outil : sa rotation doit être de 0°, 90°, 180° ou 270°."

#: static/netbox_cadplan/js/plan_editor.js:1801
#, python-format
msgid "Zone %(number)s selected"
msgstr "Zone %(number)s sélectionnée"

#: static/netbox_cadplan/js/plan_editor.js:1809
msgid "— No location —"
msgstr "— Aucun local —"

#: static/netbox_cadplan/js/plan_editor.js:1825
#, python-format
msgid "Associate with zone %(number)s"
msgstr "Associer à la zone %(number)s"

#: static/netbox_cadplan/js/plan_editor.js:1831
#, python-format
msgid ""
"Are you sure you want to unlink location \"%(location_name)s\" from zone "
"%(number)s? Once saved, the \"Plan\" tab will disappear from this "
"location's page, the zone number will reappear on the plan instead of its "
"name, and the devices/racks placed in this zone will be removed from it "
"(they will remain in their NetBox location, but will no longer be placed "
"on the plan)."
msgstr ""
"Voulez-vous vraiment délier le local « %(location_name)s » de la zone "
"%(number)s ? Une fois enregistré, l'onglet \"Plan\" disparaîtra de la "
"page de ce local, le numéro de zone réapparaîtra sur le plan à la place "
"de son nom, et les devices/racks posés dans cette zone en seront retirés "
"(ils resteront dans leur local NetBox, mais ne seront plus placés sur le "
"plan)."

#: static/netbox_cadplan/js/plan_editor.js:1853
msgid "Click a zone on the plan to associate it with a location."
msgstr "Cliquez sur une zone du plan pour l'associer à un local."

#: static/netbox_cadplan/js/plan_editor.js:1856
msgid "Loading locations…"
msgstr "Chargement des locaux…"

#: static/netbox_cadplan/js/plan_editor.js:1860
msgid "Error loading locations."
msgstr "Erreur lors du chargement des locaux."

#: static/netbox_cadplan/js/plan_editor.js:1889
#, python-format
msgid "%(saved)s association(s) saved."
msgstr "%(saved)s association(s) enregistrée(s)."

#: static/netbox_cadplan/js/plan_editor.js:1895
msgid "Network error while saving."
msgstr "Erreur réseau lors de l'enregistrement."
