msgstr "Network error while reading layers."

#: static/netbox_cadplan/js/plan_editor.js:190
msgid "Chargement de l'aperçu…"
msgstr "Loading preview…"

#: static/netbox_cadplan/js/plan_editor.js:201
msgid "Aucun élément trouvé sur ce calque."
msgstr "No elements found on this layer."

#: static/netbox_cadplan/js/plan_editor.js:205
