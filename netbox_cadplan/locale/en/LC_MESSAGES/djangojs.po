msgstr "Confirm this layer"

#: static/netbox_cadplan/js/plan_editor.js:162
msgid "Erreur réseau lors de la confirmation du calque."
msgstr "Network error while confirming the layer."

#: static/netbox_cadplan/js/plan_editor.js:170
